{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Service Lense report v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "destinations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/destination"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "required": [
    "schema_version",
    "analysis",
    "projects",
    "destinations",
    "connections",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$defs": {
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "name",
        "root",
        "languages"
      ],
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "root": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "root",
        "availability",
        "notes"
      ],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial"
              ]
            },
            "inspected": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "inspected",
            "excluded",
            "gaps"
          ],
          "additionalProperties": false
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        }
      },
      "required": [
        "scope",
        "coverage",
        "packages"
      ],
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "service_api",
            "database",
            "messaging",
            "cache",
            "storage"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "protocol": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "project_id",
        "endpoint",
        "protocol"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source_type": {
          "enum": [
            "project",
            "package"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "format": "relative-source-path"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_type",
        "source_id",
        "file",
        "line",
        "explanation"
      ],
      "additionalProperties": false
    },
    "connection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "destination_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "service_api",
            "database",
            "messaging",
            "cache",
            "storage"
          ]
        },
        "client": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "package_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "operation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "strength": {
          "enum": [
            "supported",
            "inferred",
            "unknown"
          ]
        },
        "usage": {
          "enum": [
            "used",
            "configured"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "uncertainty_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "project_id",
        "destination_id",
        "kind",
        "client",
        "package_id",
        "operation",
        "strength",
        "usage",
        "evidence",
        "uncertainty_reasons"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "id",
        "severity",
        "code",
        "message",
        "project_id",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}
